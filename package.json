{
  "name": "logistic-bot",
  "version": "2.0.0",
  "description": "Multi-user Telegram bot that periodically broadcasts each user's message to the groups they added it to",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:watch": "nodemon --watch src --ext ts --exec \"tsx src/main.ts\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "mongoose": "^9.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
