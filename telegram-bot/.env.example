# ============ Telegram controller bot ============
# @BotFather -> /newbot orqali olinadi.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ============ Per-user job account sender ============
# Har bir key — botga yozadigan job accountning Telegram numeric ID si.
# Har bir value — aynan o'sha account uchun `yarn session` yaratgan StringSession.
# Bir qatorda valid JSON bo'lishi kerak. Sessionlarni parol kabi maxfiy saqlang.
TELEGRAM_ACCOUNT_SESSIONS={"123456789":"session_for_job_account_1","987654321":"session_for_job_account_2"}

# https://my.telegram.org/apps orqali olinadi.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_api_hash

# Eski bitta-account konfiguratsiyasi ham ID va session aynan bitta job accountga
# tegishli bo'lsa ishlaydi. Yangi o'rnatishda TELEGRAM_ACCOUNT_SESSIONS ishlating:
# CONTROLLER_USER_ID=123456789
# TELEGRAM_ACCOUNT_SESSION=replace_with_private_string_session

# Har job accountning xabari shu intervalda avtomatik takrorlanadi.
BROADCAST_INTERVAL_MINUTES=60

# Parallel yuboruvchilar soni (1-50). 10 — tez va nisbatan xavfsiz.
ACCOUNT_SEND_CONCURRENCY=10
ACCOUNT_MAX_FLOOD_WAIT_SECONDS=300

# Admin panel: http://localhost:3000
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_initial_password
ADMIN_PORT=3000

# Production database and distributed state.
MONGODB_URI=mongodb://app_user:strong_password@mongo-host:27017/logistic_bot?authSource=logistic_bot
REDIS_PASSWORD=replace_with_strong_password
REDIS_URL=redis://:replace_with_strong_password@redis-host:6379
REDIS_BROADCAST_LOCK_TTL_MS=60000
