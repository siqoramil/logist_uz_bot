{
  "name": "logistic-bot",
  "version": "2.0.0",
  "description": "Multi-user Telegram bot with phone-based access and isolated group broadcasts",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:account": "tsx src/account-main.ts",
    "dev:watch": "nodemon --watch src --ext ts --exec \"tsx src/index.ts\"",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "session": "tsx scripts/generate-account-session.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:phone": "tsx scripts/phone-access-smoke.ts",
    "smoke:account": "tsx scripts/account-smoke.ts",
    "smoke:multi-account": "tsx scripts/multi-account-smoke.ts",
    "infra:up": "docker compose -f compose.yaml up -d --wait",
    "infra:down": "docker compose -f compose.yaml down"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "mongoose": "^9.6.2",
    "redis": "^6.2.1",
    "teleproto": "^1.228.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "nodemon": "^3.1.14",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
