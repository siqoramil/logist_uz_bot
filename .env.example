# ============ Telegram bot ============
# @BotFather → /newbot → tokenni shu yerga qo'ying. Majburiy.
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithYourOwn

# ============ Broadcast ============
# Yangi foydalanuvchilar uchun standart interval (daqiqa). Ixtiyoriy, standart: 60.
# Ruxsat etilgan oraliq: 5..1440. Har bir foydalanuvchi botda o'zi ham o'zgartira oladi.
BROADCAST_INTERVAL_MINUTES=60

# ============ MongoDB (with auth) ============
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change_me_to_a_long_random_string
MONGO_DB=logistic-bot
# Local dev (host mashinadan):
MONGODB_URI=mongodb://root:change_me_to_a_long_random_string@localhost:9099/logistic-bot?authSource=admin

# ============ Redis (cache, with auth) ============
# Hozircha kodda ishlatilmaydi, docker-compose uchun qoldirilgan.
REDIS_PASSWORD=change_me_to_another_long_random_string
REDIS_URL=redis://:change_me_to_another_long_random_string@localhost:6379
